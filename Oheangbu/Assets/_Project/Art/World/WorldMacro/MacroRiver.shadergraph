    "m_Value": {
        "x": 0.0,
        "y": 0.0,
        "z": 0.0
    },
    "m_SourceType": 1,
    "m_FunctionName": "MacroVerticalWaterDepth",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float deviceDepth = RawDepth;\n#if !defined(UNITY_REVERSED_Z)\ndeviceDepth = lerp(UNITY_NEAR_CLIP_VALUE, 1.0, deviceDepth);\n#endif\nfloat3 sceneWS = ComputeWorldSpacePosition(ScreenUV, deviceDepth, UNITY_MATRIX_I_VP);\nDepth = max(SurfaceWS.y - sceneWS.y, 0.0);"
}

