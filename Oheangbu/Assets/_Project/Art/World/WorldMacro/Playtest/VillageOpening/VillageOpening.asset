    Prompt: "\uC544\uC804\uC5D0\uAC8C \uD3D0\uAD11 \uC870\uC0AC \uC758\uB8B0 \uD655\uC778"
    Text: "\uB3D9\uCABD \uD3D0\uAD11\uC5D0\uC11C \uD3ED\uD30C \uC18C\uB9AC\uAC00
      \uB0AC\uC18C. \uD604\uC7A5\uC5D0 \uB0A8\uC740 \uD754\uC801\uC744 \uC0B4\uD3B4\uBCF4\uACE0
      \uB3CC\uC544\uC640 \uC8FC\uC2DC\uC624. \uC544\uC9C1 \uB204\uAC00, \uC65C \uADF8\uB7F0
      \uAC83\uC778\uC9C0\uB294 \uBAA8\uB974\uC624.\n\nG\uB97C \uB204\uB974\uBA74
      \uC624\uD589\uBD80\uB85C \uC790\uB3D9\uCC28\uB97C \uBD80\uB97C \uC218 \uC788\uC18C.
      \uD070\uAE38\uC744 \uB530\uB77C \uAE08\uD45C \uC8FC\uB9C9 \uCABD\uC73C\uB85C
      \uAC00\uBA74 \uD3D0\uAD11\uC73C\uB85C \uC774\uC5B4\uC9C0\uB294 \uC0B0\uAE38\uC774
      \uB098\uC624\uC624. \uC881\uC740 \uAE38\uC740 \uAC78\uC5B4\uC11C \uC0B4\uD3B4\uBCF4\uC2DC\uC624.\n\n\uB0B4\uB9B0
      \uB4A4 \uBA40\uC5B4\uC9C0\uBA74 \uCC28\uB294 \uC624\uD589\uBD80\uB85C \uB3CC\uC544\uC624\uB2C8,
      \uC8FC\uCC28\uD55C \uACF3\uC744 \uCC3E\uC544 \uB3CC\uC544\uC62C \uD544\uC694\uB294
      \uC5C6\uC18C. \uD070\uAE38\uC5D0\uC11C G\uB85C \uB2E4\uC2DC \uBD80\uB974\uBA74
      \uB418\uC624."
    Currency: 0
    Radius: 3.1
  EvidenceInteractionId: mine_inquiry
  IntroductionTitle: "\uAD00\uCCAD\uC5D0\uC11C \uBC1B\uC740 \uBD80\uB984"
