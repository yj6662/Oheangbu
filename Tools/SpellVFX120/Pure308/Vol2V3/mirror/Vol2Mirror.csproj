<Project Sdk="Microsoft.NET.Sdk">
  <!-- S5-a mirror: compiles the Unity-side copies (Assets/_Project/Scripts/Vol2/Rules and Vol2/Import) together with the staged
       test suites and runs all of them. Before the files are deployed to Assets, point at the stage with
       the property Vol2ScriptsRoot=../../../../Unity/Vol2S5aStage (relative to this folder). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings><Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><NuGetAudit>false</NuGetAudit>
    <RootNamespace>Vol2V3</RootNamespace>
    <Vol2ScriptsRoot Condition="'$(Vol2ScriptsRoot)'==''">../../../../../Oheangbu/Assets/_Project/Scripts</Vol2ScriptsRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(Vol2ScriptsRoot)/Vol2/Rules/*.cs;$(Vol2ScriptsRoot)/Vol2/Import/*.cs" />
    <Compile Include="../tests/*.cs;*.cs" />
  </ItemGroup>
</Project>
