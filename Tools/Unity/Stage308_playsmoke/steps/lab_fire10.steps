# 11.34 fire10: scorch streaks (scaleY 1.8-2.8, rate 260, y .2) + column wisp behind the ring (rate 18, alpha .55);
# the fx probe now prints each host's world position and the floor under it.
call SpellLab308 Run build
sleep 3
call Oheangbu.EditorTools.SpellVFX120.Vfx308Build Run build
sleep 3
call SpellLab308 Run play
wait lab
sleep 3
?call SwingProbe308 Run reset
?call SwingProbe308 Run on
?call SwingProbe308 Run target:6
sleep 1
?call SwingProbe308 Run slow:0.35
?call SwingProbe308 Run ink
?call SwingProbe308 Run cast:uB178
sleep 0.45
?call SpellLab308 Run shot:lab_fire10_3
?call SpellLab308 Run side:lab_fire10_3
?call SwingProbe308 Run fx
sleep 0.25
?call SpellLab308 Run shot:lab_fire10_4
?call SpellLab308 Run side:lab_fire10_4
?call SwingProbe308 Run fx
sleep 0.40
?call SpellLab308 Run shot:lab_fire10_5
?call SpellLab308 Run side:lab_fire10_5
?call SwingProbe308 Run fx
sleep 1.0
?call SpellLab308 Run shot:lab_fire10_6
?call SpellLab308 Run side:lab_fire10_6
?call SwingProbe308 Run fx
sleep 1.5
?call SpellLab308 Run shot:lab_fire10_7
?call SpellLab308 Run side:lab_fire10_7
?call SwingProbe308 Run fx
sleep 6
?call SwingProbe308 Run slow:1
sleep 1
?call SwingProbe308 Run report
mem
finally:
?call SpellLab308 Run stop
sleep 6
