# 11.34 fire17: free design - a baked fluid-sim fire band (fire17_fluid.py, 4 variants x 16-cel lives) stood round the target on
# camera-facing quads (root pivot, mirrored half, scale .65-1.35) over one splash stain laid flat; column as before.
call SpellLab308 Run build
sleep 3
call Oheangbu.EditorTools.SpellVFX120.Vfx308Build Run build
sleep 3
call SpellLab308 Run play
wait lab
sleep 3
?call SwingProbe308 Run reset
?call SwingProbe308 Run on
?call SwingProbe308 Run target:6
sleep 1
?call SwingProbe308 Run slow:0.35
?call SwingProbe308 Run ink
?call SwingProbe308 Run cast:uB178
sleep 0.45
?call SpellLab308 Run shot:lab_fire17_3
?call SpellLab308 Run side:lab_fire17_3
?call SwingProbe308 Run fx
sleep 0.25
?call SpellLab308 Run shot:lab_fire17_4
?call SpellLab308 Run side:lab_fire17_4
?call SwingProbe308 Run fx
sleep 0.40
?call SpellLab308 Run shot:lab_fire17_5
?call SpellLab308 Run side:lab_fire17_5
?call SpellLab308 Run top:lab_fire17_5
?call SwingProbe308 Run fx
sleep 1.0
?call SpellLab308 Run shot:lab_fire17_6
?call SpellLab308 Run side:lab_fire17_6
?call SpellLab308 Run top:lab_fire17_6
?call SwingProbe308 Run fx
sleep 1.5
?call SpellLab308 Run shot:lab_fire17_7
?call SpellLab308 Run side:lab_fire17_7
?call SpellLab308 Run top:lab_fire17_7
?call SwingProbe308 Run fx
sleep 6
?call SwingProbe308 Run slow:1
sleep 1
?call SwingProbe308 Run report
mem
finally:
?call SpellLab308 Run stop
sleep 6
